# PopQueue Server Environment Variables
# Safe defaults for local development

NODE_ENV=development
PORT=3001
TZ=Asia/Bangkok

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql://popqueue:popqueue_dev_password@localhost:5432/popqueue

# JWT Secret (minimum 16 chars)
JWT_SECRET=popqueue-local-dev-jwt-secret-key-32chars

# CORS Origin for client frontend
CORS_ORIGIN=http://localhost:3000
