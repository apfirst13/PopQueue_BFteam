# PopQueue Environment Variables
# Copy to .env and edit. Never commit .env to version control.

# Application Ports
PORT=4000
TZ=Asia/Bangkok

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql://popqueue:popqueue_dev_password@localhost:5432/popqueue
DATABASE_URL_TEST=postgresql://popqueue:popqueue_dev_password@localhost:5432/popqueue_test

# Authentication & Security
JWT_SECRET=popqueue-dev-secret-key-must-be-at-least-32-chars-long
JWT_EXPIRES_IN=8h
BCRYPT_COST=10

# Client Configuration
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Seed Account Passwords (Synthetic test data only - local development/testing)
SEED_COLLECTOR_PASSWORD=collector_dev_password123
SEED_STAFF_PASSWORD=staff_dev_password123
