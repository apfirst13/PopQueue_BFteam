# PopQueue Environment Variables
# Safe defaults for local development

NODE_ENV=development
PORT=4000
TZ=Asia/Bangkok

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql://popqueue:popqueue_dev_password@localhost:5432/popqueue
DATABASE_URL_TEST=postgresql://popqueue:popqueue_dev_password@localhost:5432/popqueue_test

# JWT Secret (minimum 32 chars, required - no default)
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars-long
JWT_EXPIRES_IN=8h

# CORS Origin for client frontend
CORS_ORIGIN=http://localhost:3000

# Authentication & Password Hashing
BCRYPT_COST=10

# Seed Account Passwords (Synthetic test data for local development)
SEED_COLLECTOR_PASSWORD=collector_dev_password123
SEED_STAFF_PASSWORD=staff_dev_password123
